# Copia este archivo como .env.deploy dentro de la VM de Azure.
# No subas .env.deploy a GitHub: contiene claves reales.

# Base de datos Azure MySQL Flexible Server.
DB_URL=jdbc:mysql://TU_HOST.mysql.database.azure.com:3306/perfumia?useSSL=true&requireSSL=true&serverTimezone=Europe/Madrid
DB_USER=TU_USUARIO
DB_PASSWORD=TU_PASSWORD

# En el primer arranque puedes usar always para crear tablas y datos base.
# Despues cambia a never para evitar reinicializaciones accidentales.
dbinitmode=never
JPA_DDL_AUTO=none
SHOW_SQL=false
SERVER_PORT=8080

# Seguridad JWT. Usa valores largos y distintos.
JWT_ACCESS_SECRET=CAMBIA_ESTE_SECRETO_ACCESS_EN_PRODUCCION
JWT_REFRESH_SECRET=CAMBIA_ESTE_SECRETO_REFRESH_EN_PRODUCCION
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Google Login.
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com

# Gemini.
GEMINI_API_KEY=tu-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Fragella.
PERFUME_API_BASE_URL=https://api.fragella.com/api/v1
PERFUME_API_KEY=tu-fragella-api-key

# Frontend generado para el Nginx de Azure.
VITE_API_URL=/api
VITE_CLOUDINARY_CLOUD_NAME=tu-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=tu-upload-preset

# CORS si decides llamar al backend directamente desde Vercel.
# Si usas el proxy /api de Vercel, igualmente puedes dejar tu dominio aqui.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://*.vercel.app

# Logs.
APP_LOG_LEVEL=INFO
SPRING_WEB_LOG_LEVEL=INFO
SPRING_SECURITY_LOG_LEVEL=INFO
HIBERNATE_SQL_LOG_LEVEL=INFO
